{
  "name": "@pauldeng/node-red-contrib-centrifuge",
  "version": "0.1.1",
  "description": "Node-RED nodes for Centrifugo over the centrifuge JavaScript client (WebSocket, JSON protocol)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pauldeng/node-red-contrib-centrifuge.git"
  },
  "bugs": {
    "url": "https://github.com/pauldeng/node-red-contrib-centrifuge/issues"
  },
  "homepage": "https://github.com/pauldeng/node-red-contrib-centrifuge#readme",
  "keywords": [
    "node-red",
    "centrifugo",
    "centrifuge",
    "websocket",
    "realtime"
  ],
  "engines": {
    "node": ">=24"
  },
  "node-red": {
    "version": ">=5.0.0",
    "nodes": {
      "centrifuge-server": "nodes/centrifuge-server.js",
      "centrifuge-in": "nodes/centrifuge-in.js",
      "centrifuge-out": "nodes/centrifuge-out.js",
      "centrifuge-request": "nodes/centrifuge-request.js"
    }
  },
  "files": [
    "nodes/",
    "lib/",
    "examples/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "fixture": "node scripts/fixture-centrifugo.mjs",
    "pretest": "node scripts/fixture-centrifugo.mjs",
    "check": "node scripts/check-package.mjs && node scripts/check-editor-contract.mjs && node scripts/check-async-style.mjs nodes lib test scripts",
    "test": "npm run check && node --test --test-concurrency=1 \"test/unit/*.test.js\" test/package-contract.test.js \"test/runtime/*.test.js\"",
    "test:unit": "node --test \"test/unit/*.test.js\"",
    "test:runtime": "node --test --test-concurrency=1 \"test/runtime/*.test.js\"",
    "test:e2e": "playwright test --project=editor",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:release": "node scripts/check-package.mjs --release",
    "docker:ensure": "bash scripts/ensure-docker-ubuntu.sh",
    "test:docker": "node --test --test-concurrency=1 \"test/docker/integration/*.test.js\"",
    "test:ui": "playwright test --project=docker-ui",
    "test:e2e:browser": "playwright test --project=docker-browser",
    "test:docker:all": "npm run test:docker && npm run test:ui && npm run test:e2e:browser"
  },
  "dependencies": {
    "centrifuge": "5.7.4"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "eslint": "10.10.0",
    "globals": "17.12.0",
    "node-red": "5.0.7",
    "prettier": "3.9.6"
  },
  "publishConfig": {
    "access": "public"
  }
}
