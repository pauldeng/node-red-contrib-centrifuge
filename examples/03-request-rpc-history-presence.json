    "type": "inject",
    "z": "1a2b3c4d5e6f7081",
    "name": "history news",
    "props": [{ "p": "payload" }, { "p": "topic", "vt": "str" }],
    "repeat": "",
    "crontab": "",
    "once": false,
    "topic": "news",
    "payload": "{\"limit\":10}",
    "payloadType": "json",
    "x": 180,
